{
  "name": "prepamm-fx",
  "version": "0.1.0",
  "private": true,
  "description": "PrepAMM FX RFQ settlement monorepo for fiat-backed stablecoins.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces && npm run compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts",
    "backend:dev": "npm run dev --workspace backend",
    "frontend:dev": "npm run dev --workspace frontend",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.14.10",
    "hardhat": "^2.22.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.1",
    "@openzeppelin/contracts": "^5.0.2",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "viem": "^2.17.5",
    "redis": "^4.6.14",
    "wagmi": "^2.10.9",
    "winston": "^3.13.1"
  }
}
